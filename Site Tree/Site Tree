Queries

create table public.c421_postulaciones (
  id uuid primary key default gen_random_uuid(),
  created_at timestamptz not null default now(),

  nombre text not null,
  apellido text not null,
  email text not null,
  whatsapp text not null,
  ubicacion text not null,
  redes text,

  biografia text not null,
  disciplina text not null,
  experiencias text,

  proyecto text not null,
  dias integer not null,
  espacio text not null,
  elementos text not null,

  obras jsonb,
  material_adicional jsonb,

  estado text not null default 'pendiente'
);

Activar RLS
alter table public.c421_postulaciones enable row level security;

Permitir solamente INSERT público

Este es importante: el formulario puede guardar postulaciones, pero nadie desde el navegador puede leerlas.

create policy "Permitir crear postulaciones C421"
on public.c421_postulaciones
for insert
to anon
with check (true);

Verificar que quedó bien
select
  column_name,
  data_type,
  is_nullable
from information_schema.columns
where table_schema = 'public'
  and table_name = 'c421_postulaciones'
order by ordinal_position;

Crear el bucket para los archivos de C-421
insert into storage.buckets (id, name, public)
values ('c421-postulaciones', 'c421-postulaciones', false);

Permitir que el formulario suba archivos

create policy "Permitir subir archivos C421"
on storage.objects
for insert
to anon
with check (
  bucket_id = 'c421-postulaciones'
);

Verificar que el bucket existe

select
  id,
  name,
  public
from storage.buckets
where id = 'c421-postulaciones';

alter table public.c421_postulaciones
add constraint c421_postulaciones_estado_check
check (estado in ('pendiente', 'enviado', 'error'));

